{
  "name": "script-vm-next",
  "version": "0.2.0-beta.1",
  "description": "JavaScript virtualization compiler with a browser-ready source API and a CLI",
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "bin": {
    "script-vm-next": "dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "ts-node src/cli.ts",
    "test": "pnpm build && vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p demo/tsconfig.json",
    "lint": "eslint src demo/src scripts *.config.*",
    "test:package": "node scripts/test-package.mjs",
    "demo:dev": "vite --config vite.config.mts --host 0.0.0.0",
    "demo:build": "vite build --config vite.config.mts",
    "demo:preview": "vite preview --config vite.config.mts --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "playwright test",
    "prepack": "pnpm build",
    "release:check": "node scripts/check-release.mjs",
    "prepublishOnly": "pnpm release:check"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "docs/compatibility.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@babel/generator": "^7.25.6",
    "@babel/parser": "^7.25.6",
    "@babel/traverse": "^7.25.6",
    "@babel/types": "^7.25.6",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^22.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vitest": "^2.1.0",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "codemirror": "6.0.2",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "vite": "8.3.2",
    "eslint": "10.11.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.0",
    "globals": "17.13.0"
  },
  "module": "./dist/index.mjs",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoMeak9/script-vm-next.git"
  },
  "homepage": "https://momeak9.github.io/script-vm-next/",
  "bugs": {
    "url": "https://github.com/MoMeak9/script-vm-next/issues"
  },
  "keywords": [
    "javascript",
    "compiler",
    "virtualization",
    "bytecode",
    "playground"
  ],
  "packageManager": "pnpm@10.34.6",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.mts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/cjs/core.d.ts",
        "default": "./dist/cjs/core.js"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "beta"
  }
}
